<!-- ======= SERVICES OVERVIEW ======= -->
<section class="section">
  <div class="container">
    <h2 class="section-title">Everything Tech — Sorted</h2>
    <p class="section-sub">From slow computers to Wi-Fi headaches, our expert technicians handle it all — at your home, your office, or remotely.</p>

    <div class="services-grid">

      <div class="service-card">
        <div class="service-icon ic-blue">💻</div>
        <h3>Computer &amp; Laptop Repairs</h3>
        <p>Slow startup, crashes, freezing, new setup, hardware faults — we get you up and running fast.</p>
        <a href="services.html" class="learn-more">Learn more →</a>
      </div>

      <div class="service-card">
        <div class="service-icon ic-red">🛡️</div>
        <h3>Virus Removal &amp; Security</h3>
        <p>Full malware scans, virus removal, anti-virus installation, and ongoing protection.</p>
        <a href="services.html" class="learn-more">Learn more →</a>
      </div>

      <div class="service-card">
        <div class="service-icon ic-purple">📱</div>
        <h3>Tablet &amp; Phone Support</h3>
        <p>Apple, Samsung, Android — setup, troubleshooting, data transfer, Wi-Fi and Bluetooth fixes.</p>
        <a href="services.html" class="learn-more">Learn more →</a>
      </div>

      <div class="service-card">
        <div class="service-icon ic-green">☁️</div>
        <h3>File Backup &amp; Recovery</h3>
        <p>Cloud backup setup, data recovery, and safeguarding your precious photos and documents.</p>
        <a href="services.html" class="learn-more">Learn more →</a>
      </div>

      <div class="service-card">
        <div class="service-icon ic-teal">📶</div>
        <h3>Internet &amp; Wi-Fi</h3>
        <p>New network setup, fix slow internet, extend Wi-Fi range, and troubleshoot dropouts.</p>
        <a href="services.html" class="learn-more">Learn more →</a>
      </div>

      <div class="service-card">
        <div class="service-icon ic-orange">📧</div>
        <h3>Email Setup &amp; Support</h3>
        <p>Gmail, Outlook, and more — set up across all devices and fix sync issues.</p>
        <a href="services.html" class="learn-more">Learn more →</a>
      </div>

